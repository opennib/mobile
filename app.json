{
  "expo": {
    "name": "opennib",
    "slug": "opennib",
    "scheme": "opennib",
    "version": "0.0.3",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.opennib.mobile",
      "deploymentTarget": "17.0",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "opennib records short audio clips while you hold the dictation button, transcribes them on-device with Whisper, and discards the audio.",
        "UIBackgroundModes": ["audio"]
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.opennib.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": ["RECORD_AUDIO"],
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#17181c"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "./plugins/with-qvac-sdk.cjs",
      "./plugins/with-app-group.cjs",
      "./plugins/with-keyboard-extension.cjs",
      "./plugins/with-shared-group-module.cjs",
      "./plugins/with-android-ime.cjs",
      "./plugins/with-bare-addon-manifest.cjs",
      "./plugins/with-release-config.cjs"
    ]
  }
}
